{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@radix-ui/*",
              "radix-ui",
              "antd",
              "@ant-design/*"
            ],
            "message": "Chỉ import component dùng chung từ \"@/components/ui\". Không import trực tiếp từ primitives bên ngoài."
          }
        ]
      }
    ]
  }
}
