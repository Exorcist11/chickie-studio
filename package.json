{
  "name": "chickie-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Chickie Studio Monorepo - Boutique Cho Thuê Trang Phục Thiết Kế & Máy Ảnh",
  "workspaces": [
    "packages/*",
    "client",
    "crm"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
